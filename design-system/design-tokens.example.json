{
  "$description": "Sample design tokens in W3C Design Tokens Community Group (DTCG) format, structured the way a design tool such as Figma Tokens Studio typically exports a token set (primitive palette + semantic aliases). Used to validate the pptx-theme-from-tokens skill, which reads this file and produces design-system/color-definition.json.",
  "color": {
    "palette": {
      "green": {
        "500": { "$value": "#15803D", "$type": "color", "$description": "Primitive: base green" },
        "700": { "$value": "#166534", "$type": "color", "$description": "Primitive: darker green, used for hover states" }
      },
      "yellow": {
        "500": { "$value": "#A16207", "$type": "color", "$description": "Primitive: base yellow" }
      },
      "gray": {
        "100": { "$value": "#F3F3F3", "$type": "color" },
        "300": { "$value": "#D9D9D9", "$type": "color" },
        "600": { "$value": "#595959", "$type": "color" },
        "800": { "$value": "#434343", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "brand": {
      "primary": {
        "$value": "{color.palette.green.500}",
        "$type": "color",
        "$description": "Primary brand color, used for accents, links, and primary CTAs"
      },
      "secondary": {
        "$value": "{color.palette.yellow.500}",
        "$type": "color",
        "$description": "Secondary brand color, used for highlights and warnings"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.palette.gray.800}",
        "$type": "color",
        "$description": "Default body text color"
      },
      "secondary": {
        "$value": "{color.palette.gray.600}",
        "$type": "color",
        "$description": "Muted / secondary text color"
      }
    },
    "background": {
      "default": {
        "$value": "{color.palette.white}",
        "$type": "color",
        "$description": "Default surface / slide background"
      },
      "accent": {
        "$value": "{color.palette.gray.100}",
        "$type": "color",
        "$description": "Subtle accent surface, e.g. card backgrounds"
      }
    },
    "border": {
      "default": {
        "$value": "{color.palette.gray.300}",
        "$type": "color",
        "$description": "Default hairline border color"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": {
        "$value": "Noto Sans JP",
        "$type": "fontFamily",
        "$description": "Font family used for titles and section headings"
      },
      "body": {
        "$value": "Noto Sans JP",
        "$type": "fontFamily",
        "$description": "Font family used for body copy"
      },
      "mono": {
        "$value": "Roboto Mono",
        "$type": "fontFamily",
        "$description": "Monospace font, used for code samples (not used by the pptx design system)"
      }
    }
  }
}
